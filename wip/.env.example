# Copiá este archivo a .env y completá los valores.

# Access token gratuito, generado en https://app.afipsdk.com
AFIP_ACCESS_TOKEN=

# Tu CUIT (receptor). Mientras no tengas certificado propio podés usar el
# CUIT público de pruebas 20409378472 para probar en modo desarrollo.
AFIP_CUIT=20247454072

# Opcional: certificado y clave propios (Homologación o Producción).
# Sin esto, Afip SDK usa el modo desarrollo (sin certificado) automáticamente.
AFIP_CERT_PATH=
AFIP_KEY_PATH=
